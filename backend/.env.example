# Server port (Render injects PORT automatically)
PORT=5000

# Comma-separated or primary frontend origin (Vercel domain)
FRONTEND_URL=https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Strictly configured owner notification & admin email
OWNER_NOTIFICATION_EMAIL=prans0309@gmail.com

# Resend transactional email API key & sender
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=HER LITTLE WORLD <onboarding@resend.dev>

# Firebase Admin SDK credentials (provide FIREBASE_SERVICE_ACCOUNT_JSON OR individual fields below)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Optional single-JSON alternative:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
